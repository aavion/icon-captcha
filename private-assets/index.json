{
  "schema": "aavion/icon-captcha@0.1.0/challenge-assets.v1",
  "description": "Curated Noto Emoji and Tabler icon pairs for IconCaptcha challenge generation.",
  "sources": {
    "emoji": {
      "name": "Noto Emoji SVG",
      "path": "emojis/",
      "licenseFile": "emojis/LICENSE"
    },
    "icons": {
      "name": "Tabler Icons Filled SVG",
      "path": "icons/",
      "licenseFile": "icons/LICENSE"
    }
  },
  "selectionPolicy": {
    "challengeSize": 6,
    "pick": "Randomly choose distinct item ids; render one item emoji as the prompt and all six matching icons as choices.",
    "categoryBalance": {
      "minCategories": 4,
      "maxItemsPerCategory": 2,
      "rationale": "Keep each challenge visually varied without making the target obvious through category isolation or making all choices too similar for humans."
    },
    "familyBalance": {
      "maxItemsPerFamily": 1,
      "field": "families",
      "rationale": "Avoid showing two choices from the same visual or semantic near-confusable group in one challenge, even when their broad categories differ."
    },
    "constraints": [
      "Prefer a replacement draw over relaxing category or family balance when enough eligible items remain.",
      "Allow a documented fallback policy only for very small extension-owned asset sets.",
      "Review the families list whenever items are added, removed, or visually restyled."
    ],
    "notes": [
      "Avoid exposing item ids, labels, filenames, or icon names to the browser during a challenge.",
      "Rasterize emoji and icons through the same server-side image pipeline before returning a challenge image.",
      "This source set avoids flags, keycaps, text symbols, skin-tone variants, brands, and highly similar face/person emojis."
    ]
  },
  "itemsCount": 100,
