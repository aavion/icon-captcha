# Studio uses this manifest to identify, validate, install, and update the extension.
# Replace every placeholder before releasing an extension based on this template.
# EXTENSION_CHANNEL defines the update channel or branch in EXTENSION_SOURCE.

##> aavion/icon-captcha manifest ###
EXTENSION_AUTHOR=aavion Media
EXTENSION_SLUG=icon-captcha
EXTENSION_NAME=IconCaptcha
EXTENSION_DESCRIPTION=IconCaptcha provider for Studio
EXTENSION_VERSION=0.1.0
EXTENSION_SCOPE=captcha-provider
EXTENSION_DEPENDENCIES=[["system",">=0.2.6"]]
EXTENSION_LICENSE=MIT
EXTENSION_HOMEPAGE=https://www.aavion.media
EXTENSION_IMAGE=assets/preview.svg
EXTENSION_CHANNEL=main
EXTENSION_SOURCE=https://github.com/aavion/icon-captcha
EXTENSION_DATE=2026-06-20
##< aavion/icon-captcha manifest ###
